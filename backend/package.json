{
  "name": "schoolofai-backend",
  "version": "1.0.0",
  "description": "Backend API server for School of AI",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "NODE_OPTIONS='--max-http-header-size=1048576' node dist/index.js",
